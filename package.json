    "examples/AGENT_INSTRUCTIONS.md",
    "examples/mcp-config.json",
    "llms-install.md",
    "LICENSE",
    "build/icon.png",
    "build/icon.icns"
  ],
  "type": "module",
  "license": "MIT",
  "author": {
    "name": "Glittering",
    "url": "https://github.com/Glittering"
  },
  "homepage": "https://github.com/Glittering/ai-browser#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Glittering/ai-browser.git"
  },
  "bugs": {
    "url": "https://github.com/Glittering/ai-browser/issues"
  },
  "mcpName": "io.github.Glittering/ai-browser",
  "keywords": [
    "ai",
    "ai-agent",
    "browser",
    "mcp",
    "model-context-protocol",
    "agent",
    "automation",
    "electron",
    "semantic",
    "web-scraping"
  ],
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "start": "node scripts/start.cjs",
