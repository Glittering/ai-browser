    "release": "node scripts/release.cjs",
    "test:watch": "vitest",
    "smoke": "node e2e/smoke_ws.cjs",
    "capabilities": "node e2e/capabilities_ws.cjs",
    "richtext": "node e2e/richtext_ws.cjs",
    "network": "node e2e/network_ws.cjs",
    "value": "node e2e/value_ws.cjs",
    "canvas": "node e2e/canvas_ws.cjs",
    "focus": "node e2e/focus_ws.cjs",
    "interact": "node e2e/interact_ws.cjs",
    "upload": "node e2e/upload_ws.cjs",
    "view": "node e2e/view_ws.cjs",
    "realsites": "node e2e/e2e_realsites.cjs",
    "realsites:meta": "vitest run tests/test_realsites_sites.js",
    "mcp": "node src/main/mcp_server.js",
    "modeldiff": "node e2e/modeldiff_ws.cjs",
    "nav": "node e2e/nav_ws.cjs",
    "audit": "node e2e/audit_ws.cjs",
    "e2e:all": "node e2e/run_all.cjs",
    "readcov": "node e2e/readcov_ws.cjs",
    "winopen": "node e2e/window_open_ws.cjs",
    "coverage": "node tools/coverage_probe.cjs",
    "build": "node scripts/build_dmg.cjs",
    "verify:build": "node scripts/verify_build.cjs",
    "install:app": "node scripts/install_app.cjs",
    "dialog": "node e2e/dialog_ws.cjs",
    "verify:app": "node e2e/shipped_ws.cjs",
    "wrapper": "node e2e/wrapper_ws.cjs",
    "paint": "node e2e/paint_ws.cjs"
