  "description": "AI-native browser — renders pixels for humans, structured semantic-tree API for agents. No screenshots, no OCR, no coordinate guessing.",
  "main": "src/main/index.js",
  "bin": {
    "ai-browser": "bin/ai-browser.cjs"
  },
  "files": [
