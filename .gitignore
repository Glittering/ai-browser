node_modules/
dist/
.env
*.log
.DS_Store
Electron.app/
cache/
screenshots/
# 图标链的可再生产物：母版 build/icon.svg 与构建输入 build/icon.icns 要提交，
# 中间位图由 scripts/render_icon.cjs 一键重建，不入库。
build/icon.png
build/icon@2x.png
build/icon.iconset/
# 验证过程落盘的截图等证据产物（outputs/verify-YYYY-MM-DD/）。只作当场取证用，
# 不进仓库 —— 一次验收就能到几十 MB。
outputs/
# tools/ holds a WS helper the committed e2e/ suite depends on (../tools/browser.cjs);
# archive it so CI/repros don't break, keep the one real asset tracked.
tools/**
!tools/browser.cjs
# coverage_probe.cjs 是 README 里写明的覆盖度量入口（低于 80% 退出码 1，可进 CI）。
# 它被 tools/** 一并忽略过，于是文档教用户跑一个仓库里根本不存在的脚本 ——
# 和这次事故同一个毛病：说法和事实不一致。它属于"真资产"，跟着 browser.cjs 一起跟踪。
!tools/coverage_probe.cjs
# 一次性调试探针请勿提交到 e2e/：只跑一次的定位脚本请挪到 tools/_oneoff/（已被 tools/** 忽略，只移不删）。
e2e/_probe/**
# 发稿物料里的一次性抓包正文与二进制配图不进仓库，避免 git add -A 误提交。
# 用 ** 以便同时覆盖 docs/ 与 docs/marketing/ 下的同名文件。
docs/**/_tmp_*
docs/**/img_*
# 本地 AI 工具的工作目录，不属于仓库内容。
.trae/
# Trae 的 HTML 分享包产物（本地导出，不属于仓库内容）
.trae-html-share-packages/
.workbuddy/
.exec-trail/

# ── 个人内容与凭据：不属于项目，绝不入库 ────────────────────────────────────
# 这个仓库要公开分发（npm / GitHub / MCP registry），下面几类是"用起来才会
# 产生"的东西。判断标准只有一条：**换个用户还可能存在吗？** 不会 → 忽略。
# 这几类一旦提交，删掉也还在 git 历史里，所以入口收窄比事后清理划算。

# 针对具体网站的自动化脚本（刷课 / 抢购 / 某个后台的固定流程…）。
# 它们绑死某个站点的选择器和业务流程，和浏览器本身无关；进仓库既泄露
# 使用意图，也会被误当成官方能力。放在 sites/<网站名>/ 下，永不入库。
sites/

# 个人文件：抓下来的数据、导出的表格、截图、临时笔记。
# 用 local/ 而不是放宽到 *.csv / *.xlsx —— 后者会误伤示例数据。
local/
local-*/

# 登录态与 cookie。浏览器本体把登录态存在 ~/.ai-browser（仓库之外），
# 但手工导出/调试用的副本经常落在工作区里。
*.cookies
cookies.json
cookies.txt
.auth/
*_auth_state.json
auth_state*.json

# 凭据文件
.env.*
!.env.example
*.pem
*.key
*.p12
id_rsa*
